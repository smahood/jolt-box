{:paths ["src"]

 ;; jolt-box/box2d wraps Box2D v3 (github.com/erincatto/box2d) for jolt.
 ;;
 ;; Box2D passes b2Vec2/b2Rot and its ids by value, which jolt.ffi can't
 ;; express, so a flat C shim (native/jb2_shim.c) takes and returns only
 ;; scalars and pointers. The shim and Box2D's own sources are compiled into
 ;; one dylib by `jolt native`, the same way ents builds flecs.
 ;; See ../guide/implementation-guide.md.
 :deps {jolt-box/common {:local/root "../common"}}

 :jolt/native [{:name "joltbox2d"
                :darwin ["native/libjoltbox2d.dylib"]
                :linux  ["native/libjoltbox2d.so"]}]

 :aliases {:test {:extra-paths ["test"]
                  :main-opts   ["-m" "jolt-box.test-runner"]}}

 :tasks
 {:requires ([babashka.fs :as fs])

  :init (do (def mac? (some? (re-find #"^Mac" (System/getProperty "os.name"))))
            (def lib (str "native/libjoltbox2d." (if mac? "dylib" "so")))
            ;; the pinned release; upgrading is a deliberate step (guide §5.1)
            (def box2d-tag "v3.1.1")
            (def box2d-home (or (System/getenv "BOX2D_HOME") "vendor/box2d")))

  box2d-src
  {:doc "clone the pinned Box2D release into vendor/box2d (skipped once there)"
   :task (if (fs/exists? (str box2d-home "/src"))
           (println "box2d-src: present -" box2d-home)
           (shell "git" "clone" "--depth" "1" "--branch" box2d-tag
                  "https://github.com/erincatto/box2d.git" box2d-home))}

  native
  {:doc "compile the shim and Box2D's sources into the library :jolt/native names"
   :depends [box2d-src]
   ;; Rebuilt only when the shim or this file is newer than the library.
   ;; Box2D's sources are listed one by one: no shell expands a glob here.
   ;; B2_ENABLE_ASSERT stays off, because a Box2D assert aborts the process
   ;; (and the REPL with it); the shim validates ids instead.
   :task (if (and (fs/exists? lib)
                  (empty? (fs/modified-since lib ["native/jb2_shim.c" "native/jb2_shim.h"
                                                  "deps.edn"])))
           (println "native: up to date -" lib)
           (let [srcs (sort (map str (fs/glob (str box2d-home "/src") "*.c")))]
             (apply shell "clang" "-O2" "-std=c17" "-shared" "-fPIC"
                    (str "-I" box2d-home "/include")
                    (str "-I" box2d-home "/src")
                    "-Inative"
                    "native/jb2_shim.c"
                    (concat srcs ["-lm" "-o" lib]))
             (println "built:" lib)))}

  test
  {:doc "headless unit tests"
   :depends [native]
   :task (shell "jolt" "-M:test")}

  clean-native
  {:doc "remove the built library (not the vendored Box2D checkout)"
   :task (do (fs/delete-if-exists lib) (println "removed:" lib))}}}
